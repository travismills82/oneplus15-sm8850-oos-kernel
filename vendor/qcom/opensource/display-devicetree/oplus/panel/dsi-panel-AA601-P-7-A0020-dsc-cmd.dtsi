			qcom,disable-rsc-solver;
			qcom,mdss-dsi-h-sync-skew = <2>;
			oplus,adfr-min-fps-mapping-table = <120 60 30 20 10 1>;
			// oplus,adfr-idle-off-min-fps = <20>;
